# HAProxy configuration file

global
    log /dev/log    local0
    log /dev/log    local1 notice
    daemon

defaults
    log     global
    mode    http
    option  httplog
    option  dontlognull
    timeout connect 5000ms
    timeout client  50000ms
    timeout server  50000ms

frontend http_front
    bind *:80
    acl is_web_local hdr(host) -i web.local
    use_backend http_back if is_web_local

backend http_back
    {% for host in groups['webservers'] %}
    server {{ host }} {{ hostvars[host]['ansible_host'] | default(host) }}:80 check
    {% endfor %}
